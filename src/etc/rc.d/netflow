#!/bin/sh

# MurOS: NetFlow exporter.
#
# FreeBSD built the exporter inside the kernel: an ng_netflow node was hooked
# onto every captured interface with ngctl and samplicate fanned the datagrams
# out to the configured collectors. Neither netgraph nor samplicate exist on
# Debian, so the capture is done in userland by softflowd, one instance per
# interface and per collector, which also removes the need for a distributor.
#
# Configuration comes from the generated /usr/local/etc/netflow.conf:
#   netflow_interfaces        interfaces to capture on
#   netflow_egress_only       subset captured in the outgoing direction only
#   netflow_destinations      collectors, as host:port (IPv6 in brackets)
#   netflow_version           5 or 9
#   netflow_active_timeout    lifetime of a flow before it is exported anyway
#   netflow_inactive_timeout  idle time before a flow is considered finished

set -u

CONF=/usr/local/etc/netflow.conf
SOFTFLOWD=/usr/sbin/softflowd
SOFTFLOWCTL=/usr/sbin/softflowctl
RUNDIR=/var/run

netflow_interfaces=""
netflow_egress_only=""
netflow_destinations=""
netflow_version="5"
netflow_active_timeout="1800"
netflow_inactive_timeout="15"

if [ -f "${CONF}" ]; then
	. "${CONF}"
fi

# An instance is identified by the interface and the rank of its collector, so
# a configuration change can be applied by stopping every instance and starting
# the ones that are still wanted.
instance_pidfile()
{
	echo "${RUNDIR}/softflowd_${1}_${2}.pid"
}

instance_ctlfile()
{
	echo "${RUNDIR}/softflowd_${1}_${2}.ctl"
}

is_egress_only()
{
	for _if in ${netflow_egress_only}; do
		if [ "${_if}" = "${1}" ]; then
			return 0
		fi
	done
	return 1
}

stop_all()
{
	for _pidfile in "${RUNDIR}"/softflowd_*.pid; do
		[ -f "${_pidfile}" ] || continue
		_pid=$(cat "${_pidfile}" 2> /dev/null)
		if [ -n "${_pid}" ] && kill -0 "${_pid}" 2> /dev/null; then
			# ask softflowd to export what it still holds before it exits
			_ctl="${_pidfile%.pid}.ctl"
			if [ -S "${_ctl}" ] && [ -x "${SOFTFLOWCTL}" ]; then
				"${SOFTFLOWCTL}" -c "${_ctl}" shutdown > /dev/null 2>&1 || kill "${_pid}"
			else
				kill "${_pid}"
			fi
		fi
		rm -f "${_pidfile}" "${_pidfile%.pid}.ctl"
	done
}

start_all()
{
	if [ ! -x "${SOFTFLOWD}" ]; then
		echo "netflow: ${SOFTFLOWD} is not installed" >&2
		return 1
	fi

	if [ -z "${netflow_interfaces}" ] || [ -z "${netflow_destinations}" ]; then
		return 0
	fi

	for _if in ${netflow_interfaces}; do
		[ -d "/sys/class/net/${_if}" ] || continue

		# softflowd reads a pcap filter as trailing arguments; "outbound"
		# is what restricts the capture to the egress direction on Linux.
		_filter=""
		if is_egress_only "${_if}"; then
			_filter="outbound"
		fi

		_index=0
		for _target in ${netflow_destinations}; do
			_index=$((_index + 1))
			_pidfile=$(instance_pidfile "${_if}" "${_index}")
			_ctlfile=$(instance_ctlfile "${_if}" "${_index}")

			# one exporter per collector: softflowd sends to a single
			# destination, which is what samplicate used to work around.
			${SOFTFLOWD} -i "${_if}" -n "${_target}" \
			    -v "${netflow_version}" \
			    -t "maxlife=${netflow_active_timeout}" \
			    -t "general=${netflow_inactive_timeout}" \
			    -p "${_pidfile}" -c "${_ctlfile}" ${_filter} || \
			    echo "netflow: failed to start the exporter on ${_if} for ${_target}" >&2
		done
	done
}

status_all()
{
	_running=0
	for _pidfile in "${RUNDIR}"/softflowd_*.pid; do
		[ -f "${_pidfile}" ] || continue
		_pid=$(cat "${_pidfile}" 2> /dev/null)
		if [ -n "${_pid}" ] && kill -0 "${_pid}" 2> /dev/null; then
			echo "netflow: exporter ${_pidfile##*/softflowd_} running as pid ${_pid}"
			_running=1
		fi
	done
	[ "${_running}" = "1" ]
}

case "${1:-}" in
start)
	stop_all
	start_all
	;;
stop)
	stop_all
	;;
restart)
	stop_all
	start_all
	;;
status)
	status_all
	;;
*)
	echo "usage: $0 {start|stop|restart|status}" >&2
	exit 64
	;;
esac
