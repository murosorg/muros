/*
 * MurOS: recovery for Debian.
 *
 * The FreeBSD version restored /etc/master.passwd, /etc/group, /etc/ttys and
 * the FreeBSD php.ini, rebuilt the password databases with pwd_mkdb and replayed
 * the pre and post install scripts of every pkg that owns a user or a group.
 * None of that applies here: the accounts belong to the Debian packages that
 * create them, there is no password database to rebuild and no /etc/ttys since
 * getty is a systemd unit. What can still be broken and is owned by MurOS is the
 * PHP configuration the whole GUI depends on, the list of login shells, the
 * runtime directories and the state of the package database.
 *
 * Only native PHP functions plus passthru() are used, so recovery keeps working
 * with a broken include path.
 */

$php_ini_common = <<<EOF
; File generated via recovery
include_path = "/usr/local/etc/inc:/usr/local/www:/usr/local/opnsense/mvc:/usr/local/opnsense/contrib:/usr/local/share/pear:/usr/local/share"
memory_limit = 1G
max_execution_time = 300
max_input_vars = 5000
post_max_size = 200M
upload_max_filesize = 200M
upload_tmp_dir = /var/lib/php/tmp
session.save_path = /var/lib/php/sessions
error_log = /var/lib/php/tmp/PHP_errors.log
date.timezone = "Etc/UTC"
expose_php = Off
opcache.interned_strings_buffer = 32
opcache.max_accelerated_files = 24000
opcache.validate_timestamps = 1
opcache.revalidate_freq = 60
opcache.save_comments = 1
realpath_cache_size = 4M
realpath_cache_ttl = 300

EOF;

/* the web SAPI is a worker pool and streams server-sent events */
$php_ini_fpm = <<<EOF
opcache.enable = 1
opcache.enable_cli = 0
opcache.memory_consumption = 256
output_buffering = Off
implicit_flush = On

EOF;

/* the command line SAPI backs configd, one short lived process per action */
$php_ini_cli = <<<EOF
opcache.enable = 1
opcache.enable_cli = 1
opcache.file_cache = /var/lib/php/opcache
opcache.file_cache_only = 1
opcache.file_cache_consistency_checks = 1

EOF;

$known_shells = [
    '/bin/sh',
    '/bin/bash',
    '/usr/bin/bash',
    '/usr/bin/zsh',
    '/usr/local/sbin/opnsense-installer',
    '/usr/local/sbin/opnsense-shell',
];

function recover_php($php_ini_common, $php_ini_fpm, $php_ini_cli)
{
    echo "===> Restoring the PHP configuration\n";

    foreach (['fpm' => $php_ini_fpm, 'cli' => $php_ini_cli] as $sapi => $extra) {
        foreach (glob("/etc/php/*/{$sapi}/conf.d") as $dir) {
            file_put_contents("{$dir}/99-muros.ini", $php_ini_common . $extra);
        }
    }

    /* the directories the settings above point at */
    foreach (['/var/lib/php/tmp', '/var/lib/php/sessions', '/var/lib/php/opcache'] as $dir) {
        @mkdir($dir, 0750, true);
    }
    passthru('/usr/bin/chown -R www-data:www-data /var/lib/php/tmp /var/lib/php/sessions 2> /dev/null');
    passthru('/usr/bin/chown root:www-data /var/lib/php/opcache 2> /dev/null');
    /* a stale opcode cache survives a broken upgrade and hides the fix */
    array_map('unlink', glob('/var/lib/php/opcache/*/*') ?: []);
}

function recover_shells($known_shells)
{
    echo "===> Restoring /etc/shells\n";

    $shells = [];
    foreach (file('/etc/shells', FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: [] as $line) {
        $shells[] = $line;
    }

    foreach ($known_shells as $shell) {
        if (file_exists($shell) && !in_array($shell, $shells)) {
            $shells[] = $shell;
        }
    }

    file_put_contents('/etc/shells', implode(PHP_EOL, $shells) . PHP_EOL);
}

function recover_packages()
{
    if (!file_exists('/usr/bin/dpkg')) {
        return;
    }

    echo "===> Completing interrupted package configuration\n";

    /* replays the maintainer scripts of everything left half configured, which
     * is what the replay of the pkg install scripts used to cover */
    passthru('/usr/bin/dpkg --configure -a');
}

function recover_base($php_ini_common, $php_ini_fpm, $php_ini_cli, $known_shells)
{
    recover_php($php_ini_common, $php_ini_fpm, $php_ini_cli);
    recover_shells($known_shells);
    passthru('/bin/sync');
}

function recover_pkg()
{
    recover_packages();

    echo "===> Restoring critical core files\n";

    foreach (['/usr/local/etc/bogons', '/usr/local/etc/bogonsv6'] as $file) {
        if (!file_exists($file) || filesize($file) === 0) {
            @copy("{$file}.sample", $file);
        }
    }

    /* the runtime tree, normally created at boot by systemd-tmpfiles */
    if (file_exists('/usr/bin/systemd-tmpfiles')) {
        passthru('/usr/bin/systemd-tmpfiles --create 2> /dev/null');
    }

    passthru('/bin/sync');
}

$stage = isset($argv[1]) ? $argv[1] : 'both';

switch ($stage) {
    case 'base':
        recover_base($php_ini_common, $php_ini_fpm, $php_ini_cli, $known_shells);
        break;
    case 'pkg':
        recover_pkg();
        break;
    default:
        recover_base($php_ini_common, $php_ini_fpm, $php_ini_cli, $known_shells);
        recover_pkg();
        break;
}
