[Unit]
# Instance name is the MurOS interface the session belongs to (wan, opt1, ...),
# which is also the name of the generated pppd options file. The interface name
# of the session itself (pppoe0, pptp0, ...) is set by pppd through "ifname".
Description=MurOS PPP session on %i
Documentation=https://github.com/ecritel/muros
After=network.target
ConditionPathExists=/var/etc/ppp/%i.conf

[Service]
# pppd keeps the session up on its own (persist, maxfail 0, holdoff), systemd
# only has to cover a real exit, for instance a fatal option error or a kill.
ExecStart=/usr/sbin/pppd nodetach file /var/etc/ppp/%i.conf
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
