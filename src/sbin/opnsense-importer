ZPOOL_IMPORT_PATH=/dev
export ZPOOL_IMPORT_PATH

INSTALL="/.probe.for.readonly"
MNT="/tmp/hdrescue"
SHELL="/bin/sh"
WAIT="......."

if [ "$(id -u)" != "0" ]; then
	echo "Must be root."
	exit 1
fi

DO_BOOT=
DO_MANUAL=
DO_PASSWORD=
DO_VERBOSE=
DO_ZFS=

bootstrap_and_exit()
{
	RET=${1}

	# ensure config directory structure
	mkdir -p /conf/backup
	mkdir -p /conf/sshd

	# create initial config.xml if necessary
	if [ ! -f /conf/config.xml ]; then
		echo -n "Bootstrapping config.xml..."
		cp /usr/local/etc/config.xml /conf/config.xml
		echo "done."
	fi

	# clean up after a finished import
	if [ -d ${MNT} -a "$(mount | grep -cw ${MNT})" != "0" ]; then
		if [ -n "${PART}" ]; then
			umount ${MNT}
		elif [ -n "${POOL}" ]; then
			zpool export ${POOL}
		fi
	fi

	zfs_unload

	# error code given or assumed ok (trap)
	if [ -z "${RET}" ]; then
		RET=0
	fi

	exit "${RET}"
}

while getopts bmpzV OPT; do
	case ${OPT} in
	b)
		DO_BOOT="-b"
		;;
	m)
		DO_MANUAL="-m"
		;;
	p)
		DO_PASSWORD="-p"
		;;
	V)
		DO_VERBOSE="-V"
		;;
	z)
		DO_ZFS="-z"
		;;
	*)
		echo "Usage: man ${0##*/}" >&2
		exit 1
		;;
	esac
done

shift $((OPTIND - 1))

if [ -n "${DO_VERBOSE}" ]; then
	set -x
fi

DO_DEV=${1}

timeout_prompt()
{
	OUTPUT=$(echo ${2} | sed 's/./& /g')
	MESSAGE=${1}
	RETURN=1

	echo -n "${MESSAGE} "

	stty cbreak -echo
	for NEXT in ${OUTPUT}; do
		echo -n ${NEXT}
		if timeout 1 dd of=/dev/null count=1 status=none; then
			RETURN=0
			break
		fi
	done
	stty -cbreak echo

	echo

	return ${RETURN}
}

# MurOS: ZFS is a loadable module here as well, but it is loaded with modprobe
# and it is optional: the installer lays out ext4, so a machine without
# zfsutils-linux simply has no pool to offer. The FreeBSD kldstat, kldload and
# kldunload calls made every run of the importer fail before it listed anything.
zfs_load()
{
	if ! have_zfs; then
		export POOLS=
		return 0
	fi

	if [ ! -d /proc/spl/kstat/zfs ]; then
		export UNLOAD_ZFS="yes"
		modprobe zfs 2> /dev/null
	fi

	export POOLS=$(zfs_probe)
}

zfs_unload()
{
	if [ -n "${UNLOAD_ZFS}" ]; then
		modprobe -r zfs 2> /dev/null
	fi
}

have_zfs()
{
	command -v zpool > /dev/null 2>&1
}

zfs_probe()
{
	if ! have_zfs; then
		return 0
	fi

	zpool import -aNf > /dev/null 2> /dev/null

	zpool list -H -o name | while read ZPOOL ZMORE; do
		if [ -z "${ZPOOL}" ]; then
			continue
		fi
		ZGUID=$(zpool list -H -o guid ${ZPOOL})
		ZSIZE=$(zpool list -H -o size ${ZPOOL})
		if ! findmnt -n -o SOURCE / | grep -q "^${ZPOOL}\b"; then
			zpool export ${ZPOOL} > /dev/null 2> /dev/null
		fi
		echo "${ZPOOL} ${ZGUID} ${ZSIZE}"
	done
}

# MurOS: the file system type as the kernel sees it, so the mount below does not
# have to guess. FreeBSD probed fixed partition names, s1a for MBR UFS and p3
# for GPT UFS, then fell back to msdos and cd9660 by name as well.
fs_type()
{
	blkid -o value -s TYPE "${1}" 2> /dev/null
}

# MurOS: partitions of a device, in the order the kernel enumerates them. Covers
# the sdXN, nvmeXnYpN and mmcblkXpN spellings without knowing about any of them.
device_partitions()
{
	lsblk -lnp -o NAME,TYPE "/dev/${1}" 2> /dev/null | while read NAME NTYPE; do
		if [ "${NTYPE}" = "part" ]; then
			echo "${NAME}"
		fi
	done
}

import_start()
{
	local DEV=${1}

	# MurOS: no guessing anymore. blkid tells what each partition holds and
	# the mount below is left on auto, which covers ext4 as installed, vfat
	# and iso9660 of an installer image, and anything else the kernel can
	# read. What is not a file system, a swap area, a LUKS container, an LVM
	# member or a raid member, is skipped.

	export PART=
	export TYPE=
	export POOL=

	if [ "$(echo ${POOLS} | grep -c "^${DEV} ")" != "0" ]; then
		# ZFS pool
		export POOL="${DEV}"
		return 0
	fi

	# a partition of the device carrying a file system the kernel knows, the
	# root of an installation first: the caller mounts each candidate in turn
	# and keeps the one holding /conf/config.xml
	for CANDIDATE in $(device_partitions ${DEV}); do
		CTYPE=$(fs_type ${CANDIDATE})
		case "${CTYPE}" in
		''|swap|crypto_LUKS|LVM2_member|zfs_member|linux_raid_member)
			continue
			;;
		esac
		export PART="${PART}${PART:+ }${CANDIDATE}"
	done

	if [ -z "${PART}" ]; then
		# the whole device, an installer image or a formatted disk without
		# a partition table
		CTYPE=$(fs_type "/dev/${DEV}")
		if [ -n "${CTYPE}" ]; then
			export PART="/dev/${DEV}"
		fi
	fi

	if [ -z "${PART}" ]; then
		return 1
	fi

	export TYPE="auto"

	return 0
}


DEVS=
POOLS=

if [ -n "${DO_ZFS}" ]; then
	zfs_load
	zfs_unload
	if [ -n "${POOLS}" ]; then
		echo "${POOLS}"
	fi
	exit 0
fi

trap bootstrap_and_exit 2

if [ -n "${DO_BOOT}" ]; then
	touch ${INSTALL} 2> /dev/null
	if [ -f ${INSTALL} -a -f /conf/config.xml ]; then
		bootstrap_and_exit 0
	fi

	if ! timeout_prompt \
	    'Press any key to start the configuration importer:' ${WAIT}; then
		bootstrap_and_exit 0
	fi
fi

zfs_load

if [ -n "${DO_DEV}" ]; then
	if ! import_start ${DO_DEV}; then
		echo "No known partition layout was found for '${DO_DEV}'."
		bootstrap_and_exit 1
	fi
fi

# MurOS: the device list comes from lsblk, which covers the disks, the software
# raid and the multipath devices in one go. camcontrol, gmirror and graid do not
# exist here, so the list used to be empty and the prompt below had nothing to
# offer.
DEVS=$(
	lsblk -dn -o NAME,SIZE,MODEL,TYPE | while read LNAME LSIZE LREST; do
		case "${LREST##* }" in
		disk|raid*|md|dm|mpath)
			printf "%-12s<%s %s>\n" "${LNAME}" "${LSIZE}" "${LREST% *}"
			;;
		esac
	done
	echo "${POOLS}" | while read ZPOOL ZGUID ZSIZE ZMORE; do
		if [ -z "${ZPOOL}" ]; then
			continue
		fi
		printf "%-12s<%s %s>\n" "${ZPOOL}" "${ZSIZE}" "ZFS pool ${ZGUID}"
	done
)

while : ; do
	if [ -z "${DO_DEV}" ]; then
		echo
		echo "${DEVS}"
		echo
		read -p "Select device to import from (e.g. sda) or leave blank to exit: " DEV
		echo

		if [ -z "${DEV}" ]; then
			bootstrap_and_exit 0
		elif [ "${DEV}" = "!" ]; then
			# secret escape! (not so secret now, is it?)
			${SHELL}
			continue
		elif ! import_start ${DEV}; then
			echo "No known partition layout was found for '${DEV}'."
			continue
		fi
	fi

	mkdir -p ${MNT}

	if [ -n "${PART}" ]; then
		# MurOS: PART holds every partition of the device carrying a known file
		# system, in kernel order. Each one is checked, mounted and kept only if
		# it looks like an installation, so a machine with a separate boot or
		# EFI partition does not stop the importer on the first one.
		CHOSEN=

		for CANDIDATE in ${PART}; do
			CTYPE=$(fs_type ${CANDIDATE})
			echo "Starting import for partition '${CANDIDATE}' (${CTYPE:-unknown})."
			echo

			case "${CTYPE}" in
			ext2|ext3|ext4)
				echo -n "Running fsck..."
				fsck -y -t ${CTYPE} ${CANDIDATE} > /dev/null 2> /dev/null
				echo "done."
				;;
			esac

			if ! mount ${CANDIDATE} ${MNT} 2> /dev/null; then
				continue
			fi

			if [ -n "${DO_MANUAL}" ] || [ -f "${MNT}/conf/config.xml" ] || \
			    [ -f "${MNT}/usr/local/sbin/opnsense-shell" ]; then
				CHOSEN=${CANDIDATE}
				break
			fi

			umount ${MNT}
		done

		if [ -z "${CHOSEN}" ]; then
			echo "The device could not be mounted."
			PART=
		else
			PART=${CHOSEN}
		fi
	elif [ -n "${POOL}" ]; then
		echo "Starting import for ZFS pool '${POOL}'."
		echo

		zpool import -fNR ${MNT} ${POOL}
		if ! mount -t zfs ${POOL}/ROOT/default ${MNT}; then
			echo "The pool could not be mounted."
			POOL=
		fi
	else
		if [ -n "${DO_DEV}" ]; then
			bootstrap_and_exit 1
		fi

		continue
	fi

	if [ -n "${DO_MANUAL}" ]; then
		echo "# Manual shell mode, selected file system available at ${MNT}"
		${SHELL}
		break
	elif [ -n "${DO_PASSWORD}" ]; then
		if [ -f "${MNT}/usr/local/sbin/opnsense-shell" ]; then
			# MurOS: a Debian chroot needs the three kernel file systems
			# bind mounted, there is no devfs to mount, and the dynamic
			# linker cache is refreshed by ldconfig itself and not by an
			# rc script.
			for KFS in dev proc sys; do
				mount --bind /${KFS} ${MNT}/${KFS}
			done
			chroot ${MNT} /sbin/ldconfig
			chroot ${MNT} /usr/local/sbin/opnsense-shell password root -x 0
			for KFS in sys proc dev; do
				umount ${MNT}/${KFS}
			done

			echo "The password was reset successfully."

			break
		else
			echo "The installed version does not yet support recovery."

			if [ -n "${DO_DEV}" ]; then
				bootstrap_and_exit 1
			fi
		fi
	elif [ -f "${MNT}/conf/config.xml" ]; then
		if [ "$(grep -cx -- '---- BEGIN config.xml ----' ${MNT}/conf/config.xml)" != "0" ]; then
			if ! opnsense-crypt ${MNT}/conf/config.xml; then
				echo "The file /conf/config.xml could not be decrypted."

				if [ -n "${DO_DEV}" ]; then
					bootstrap_and_exit 1
				fi

				continue
			fi
		fi

		rm -rf /conf/*

		for FILE in captiveportal.sqlite config.xml netflow.tgz rrd.tgz; do
			if [ -f "${MNT}/conf/${FILE}" ]; then
				echo -n "Restoring ${FILE}..."
				cp "${MNT}/conf/${FILE}" /conf
				echo "done."
			fi
		done

		# This is a historic restore, but we use the file in use by
		# dhcp6c itself instead of using the obsolete one in /conf
		# since /var MFS is no more and the DUID can be optionally
		# stored in the config.xml anyway if a backup is wanted.
		FILE="/var/db/dhcp6c_duid"

		if [ -f "${MNT}${FILE}" ]; then
			echo -n "Restoring ${FILE}..."
			cp "${MNT}${FILE}" /var/db
			echo "done."
		fi

		for DIR in backup sshd; do
			if [ -d "${MNT}/conf/${DIR}" ]; then
				echo -n "Restoring ${DIR}..."
				cp -r "${MNT}/conf/${DIR}" /conf
				echo "done."
			else
				mkdir -p "/conf/${DIR}"
			fi
		done

		for FILE in $(find /conf/sshd -type f -name '*key'); do
			# fixup possibly unsupported file system permissions
			chmod 600 ${FILE}
		done

		# hooray, we're done!
		break
	else
		echo "The file /conf/config.xml could not be found."

		if [ -n "${DO_DEV}" ]; then
			bootstrap_and_exit 1
		fi
	fi
done

if [ -z "${DO_BOOT}${DO_MANUAL}${DO_PASSWORD}" ]; then
	echo "Please reboot."
fi

bootstrap_and_exit 0
