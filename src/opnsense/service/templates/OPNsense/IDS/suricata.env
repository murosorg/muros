{#
    MurOS: the rc.conf.d fragment this replaces carried the enable flag, the
    daemon flags and the capture mode for the FreeBSD rc script. rc.freebsd is
    gone, so the same information is written as a plain environment file, sourced
    by /usr/local/etc/rc.d/suricata. The FreeBSD capture modes went with it:
    netmap and divert sockets do not exist on Linux, the equivalents are
    af-packet for detection and the netfilter queue for inline enforcement.
#}
{% if not helpers.empty('OPNsense.IDS.general.enabled') %}
SURICATA_ENABLE="yes"
{% else %}
SURICATA_ENABLE="no"
{% endif %}
{% set mode = OPNsense.IDS.general.mode|default('afpacket') %}
{% if mode in ['nfqueue', 'netmap', 'divert'] %}
SURICATA_MODE="nfqueue"
SURICATA_QUEUES="{{ OPNsense.IDS.general.divert_listeners|default('1') }}"
{% else %}
SURICATA_MODE="afpacket"
SURICATA_QUEUES="0"
{% endif %}
{% set devices=[] %}
{% if helpers.exists('OPNsense.IDS.general.interfaces') %}
{%   for intfName in OPNsense.IDS.general.interfaces.split(',') %}
{%     do devices.append(helpers.physical_interface(intfName)) %}
{%   endfor %}
{% endif %}
SURICATA_INTERFACES="{{ devices|join(' ') }}"
{% if not helpers.empty('OPNsense.IDS.general.verbosity') %}
SURICATA_VERBOSITY="-{{ OPNsense.IDS.general.verbosity }}"
{% else %}
SURICATA_VERBOSITY=""
{% endif %}
